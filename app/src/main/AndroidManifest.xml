<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Edge-gesture feedback: the Q25 vibrator has no predefined effects, so the system haptic is inaudible. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Shift+Space language switch. Not grantable from the UI; granted once over adb
         (or su): pm grant com.kgr.q25toolbox android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- List launchable apps for the per-app keyboard-block picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Q25Toolbox"
        android:supportsRtl="true">

        <!-- Xposed / LSPosed module metadata. Enable in LSPosed / Vector and
             scope to the launcher to get the grid / masonry Overview. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Two-row grid / masonry Recents/Overview for Launcher3 QuickStep" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|layoutDirection"
            android:theme="@style/Theme.Q25Toolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.Q25PassthroughIme"
            android:label="Q25 Passthrough"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/passthrough_ime" />
        </service>

        <service
            android:name=".service.Q25AccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Advertises res/raw/keyboard_layout_en_us.kcm to the framework so it
             can be picked under Settings -> Physical keyboard. Must stay
             exported: the system reads the meta-data via PackageManager. -->
        <receiver
            android:name=".modules.KeyboardLayoutReceiver"
            android:exported="true"
            android:label="@string/keyboard_layouts_label">
            <intent-filter>
                <action android:name="android.hardware.input.action.QUERY_KEYBOARD_LAYOUTS" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.input.metadata.KEYBOARD_LAYOUTS"
                android:resource="@xml/keyboard_layouts" />
        </receiver>

        <receiver
            android:name=".modules.BesLoudnessReceiver"
            android:exported="false" />

        <!-- Other apps (Key Mapper) run one of our actions: see RunActionReceiver. -->
        <receiver
            android:name=".service.RunActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kgr.q25toolbox.action.RUN" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.TickerNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
